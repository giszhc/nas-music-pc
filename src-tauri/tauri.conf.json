{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "聆境音乐",
  "version": "0.1.0",
  "identifier": "com.lingjing.music",
  "build": {
    "frontendDist": "../native"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "聆境音乐",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost nas: http://nas.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost nas: http://nas.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Music",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
